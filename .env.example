# ===================================================================
# CONFIGURACIÓN DE SUPABASE (Opcional para pruebas, necesario para producción)
# ===================================================================
# Para conectar tu base de datos de Supabase:
# 1. Regístrate o inicia sesión en https://supabase.com
# 2. Crea un nuevo proyecto.
# 3. Ve al "SQL Editor" en Supabase y ejecuta el script: supabase_init.sql
# 4. Ve a Project Settings -> API y copia tus credenciales aquí.
# 5. Guarda este archivo como '.env.local' en la misma carpeta.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui
VITE_SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
